{
  "manifest_version": 3,
  "name": "Job Autofill",
  "version": "1.1.0",
  "description": "Fill job applications (Workday, Greenhouse, Lever, Ashby and more) from your saved profile in one click. Your data never leaves your browser.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "*://*.myworkdayjobs.com/*",
    "*://*.myworkday.com/*",
    "*://*.workday.com/*",
    "*://*.greenhouse.io/*",
    "*://*.lever.co/*",
    "*://*.ashbyhq.com/*",
    "*://*.icims.com/*",
    "*://*.smartrecruiters.com/*",
    "*://*.jobvite.com/*",
    "*://*.taleo.net/*",
    "*://*.successfactors.com/*",
    "*://*.bamboohr.com/*"
  ],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Job Autofill",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" },
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "src/background.js"
  },
  "commands": {
    "fill-page": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Fill the application on this page"
    }
  }
}
